static func apply_galosh_participation(level: Node3D, level_id: String) -> bool:
	if not _galosh_eligible(OS.has_feature("android"),RenderingServer.get_current_rendering_method(),level_id):
		return false
	return _galosh_participation(level, level_id)

static func _galosh_eligible(android: bool, renderer: String, level_id: String) -> bool:
	return android and renderer == "mobile" and level_id == "galosh_art"

static func _galosh_participation(level: Node3D, level_id: String) -> bool:
	if level_id != "galosh_art": return false
	if FileAccess.get_sha256("res://assets/levels/galosh_art/level.json") != GALOSH_LEVEL_SHA:
		return _fallback("Galosh participation", "authored level fingerprint")
	var receivers=[]
	var lights=[]
	for root_name in GALOSH_ROOTS:
		var declaration=GALOSH_ROOTS[root_name]
		var receiver=level.get_node_or_null(NodePath(root_name)) as MeshInstance3D
		if receiver == null or receiver.layers != 1 or not receiver.position.is_equal_approx(_galosh_vec(declaration.position)) or not receiver.rotation_degrees.is_equal_approx(_galosh_vec(declaration.rotation)):
			return _fallback("Galosh participation", "receiver instance "+root_name)
		var expected_scale=_galosh_vec(declaration.scale) if declaration.scale is Array else Vector3.ONE*declaration.scale
		if not receiver.scale.is_equal_approx(expected_scale):
			return _fallback("Galosh participation", "receiver scale "+root_name)
		for target in declaration.targets:
			var node=receiver if target.index < 0 else receiver.get_node_or_null(NodePath("MobileReceiver%02d" % int(target.index))) as MeshInstance3D
			if node == null or node.mesh == null or node.layers != 1 or node.mesh.resource_path != target.path:
				return _fallback("Galosh participation", "receiver piece "+root_name)
			receivers.append([node,int(target.layer)])
	for light_name in GALOSH_LIGHTS:
		var declaration=GALOSH_LIGHTS[light_name]
		var light=level.get_node_or_null(NodePath(light_name)) as OmniLight3D
		if light == null or light.light_cull_mask != 4294967295 or not light.position.is_equal_approx(_galosh_vec(declaration.position)) or not is_equal_approx(light.omni_range,declaration.range) or not is_equal_approx(light.light_energy,1.0) or not is_equal_approx(light.light_indirect_energy,declaration.indirect) or light.shadow_enabled:
			return _fallback("Galosh participation", "static light "+light_name)
		var color=Color(declaration.color[0],declaration.color[1],declaration.color[2])
		if not is_equal_approx(light.light_color.r,color.r) or not is_equal_approx(light.light_color.g,color.g) or not is_equal_approx(light.light_color.b,color.b):
			return _fallback("Galosh participation", "static color "+light_name)
		lights.append([light,int(declaration.mask)])
	# Atomic participation change after the complete source/receiver contract.
	for pair in receivers: pair[0].layers=pair[1]
	for pair in lights: pair[0].light_cull_mask=pair[1]
	print("[Galosh participation] Applied; receivers="+str(receivers.size()))
	return true

static func _galosh_vec(a):
	return Vector3(a[0],a[1],a[2])
